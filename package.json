    "@turf/turf": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "markdown-it": "^15.0.2",
    "maplibre-gl": "^6.11.2",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.7.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
