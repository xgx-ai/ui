{
  "packageManager": "bun@1.4.2",
  "name": "@xgx/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./packages/ui/src/index.ts",
  "exports": {
    ".": "./packages/ui/src/index.ts",
    "./auth": "./packages/ui/src/auth/index.ts",
    "./base.css": "./packages/ui/src/base.css",
    "./collab": "./packages/ui/src/collab/index.ts",
    "./documents": "./packages/ui/src/documents/index.ts",
    "./editor": "./packages/ui/src/editor/index.ts",
    "./icons": "./packages/ui/src/icons.index.ts",
    "./map": "./packages/ui/src/map/index.ts",
    "./map/style.css": "./packages/ui/src/map/style.css",
    "./query": "./packages/query/src/index.tsx",
    "./schema-form": "./packages/ui/src/forms/schema-form/index.ts",
    "./sortablejs": "./packages/ui/src/dnd/sortablejs/index.ts",
    "./bun-plugin-solid": "./packages/ui/src/bun-plugins/solid.ts",
    "./bun-plugin-tanstack-router": "./packages/ui/src/bun-plugins/tanstack-router.ts",
    "./solid": "./packages/solid/src/index.ts",
    "./prefabs": "./packages/prefabs/src/index.ts",
    "./prefabs/data-table": "./packages/prefabs/src/data-display/table.tsx",
    "./prefabs/search-infinite": "./packages/prefabs/src/forms/search-infinite.tsx",
    "./prefabs/table-infinite": "./packages/prefabs/src/table-infinite/index.ts",
    "./biome": "./packages/solid/biome/ui.json",
    "./biome-app": "./packages/solid/biome/ui-app.json"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "demo": "bun ./apps/demo/index.html --port=5174",
    "demo:build": "bun ./apps/demo/build.ts",
    "demo:preview": "bun ./apps/demo/dist/index.html --port=5174",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run solid:typecheck && bun run solid:test && bun run beta:probes && bun run query:typecheck && bun run query:test && bun run typecheck && bun run ui:test && bun run prefabs:typecheck && bun run prefabs:test && bun run demo:typecheck && bun run demo:build && bun run test:static",
    "test:static": "bun ./apps/demo/test.ts",
    "test:browser": "env -u FORCE_COLOR -u NO_COLOR playwright test",
    "test:aria": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/aria.spec.ts",
    "test:keyboard": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/keyboard.spec.ts",
    "test:functional": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/functional.spec.ts",
    "test:a11y": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/a11y.spec.ts",
    "test:visual": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/visual.spec.ts",
    "test:visual:update": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/visual.spec.ts --update-snapshots",
    "test:ci": "bun run lint && bun run format:check && bun run test && bun run test:browser",
    "typecheck": "tsc -p packages/ui/tsconfig.json --noEmit",
    "solid:typecheck": "tsc -p packages/solid/tsconfig.json --noEmit",
    "solid:test": "bun test --conditions=browser packages/solid/test",
    "beta:probes": "bun test --conditions=browser --conditions=development packages/solid/beta-probes/register.test.ts && bun test --conditions=browser --conditions=development packages/solid/beta-probes/halts-s2.test.ts && bun test --conditions=browser --conditions=development packages/solid/beta-probes/owned-scope-write.test.ts",
    "query:typecheck": "tsc -p packages/query/tsconfig.json --noEmit",
    "query:test": "bun test --conditions=browser --preload ./packages/query/test/preload.ts packages/query/test",
    "prefabs:typecheck": "tsc -p packages/prefabs/tsconfig.json --noEmit",
    "prefabs:test": "bun test --conditions=browser --preload ./packages/query/test/preload.ts packages/prefabs/test",
    "demo:typecheck": "tsc -p apps/demo/tsconfig.json --noEmit",
    "ui:test": "bun run --cwd packages/ui test"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-geocoder": "^1.9.4",
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.0",
    "@ampproject/remapping": "^2.3.0",
