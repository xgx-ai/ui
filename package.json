    "@tiptap/starter-kit": "3.20.4",
    "@xyflow/system": "^0.0.75",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-solid": "^0.563.0",
    "markdown-it": "^14.1.0",
    "tailwind-merge": "^3.4.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
