{
  "name": "@xgx/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./packages/ui/src/index.ts",
  "exports": {
    ".": "./packages/ui/src/index.ts",
    "./base.css": "./packages/ui/src/base.css",
    "./collab": "./packages/ui/src/collab/index.ts",
    "./documents": "./packages/ui/src/documents/index.ts",
    "./editor": "./packages/ui/src/editor/index.ts",
    "./flow": "./packages/ui/src/flow/index.ts",
    "./flow/system": "./packages/ui/src/flow/system.ts",
    "./flow/style.css": "./packages/ui/src/flow/styles/index.css",
    "./icons": "./packages/ui/src/icons.index.ts",
    "./schema-form": "./packages/ui/src/forms/schema-form/index.ts",
    "./solid-runtime": "./packages/ui/src/solid-runtime/index.ts",
    "./bun-plugin-solid": "./packages/ui/src/bun-plugins/solid.ts",
    "./bun-plugin-tanstack-router": "./packages/ui/src/bun-plugins/tanstack-router.ts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "demo": "bun ./apps/demo/index.html --port=5174",
    "demo:build": "bun ./apps/demo/build.ts",
    "demo:preview": "bun ./apps/demo/dist/index.html --port=5174",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run query:typecheck && bun run typecheck && bun run prefabs:typecheck && bun run demo:typecheck && bun run demo:build && bun run test:static",
    "test:static": "bun ./apps/demo/test.ts",
    "test:browser": "env -u FORCE_COLOR -u NO_COLOR playwright test",
    "test:aria": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/aria.spec.ts",
    "test:keyboard": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/keyboard.spec.ts",
    "test:functional": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/functional.spec.ts",
    "test:a11y": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/a11y.spec.ts",
    "test:visual": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/visual.spec.ts",
    "test:visual:update": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/visual.spec.ts --update-snapshots",
    "test:ci": "bun run lint && bun run format:check && bun run test && bun run test:browser",
    "typecheck": "tsgo -p packages/ui/tsconfig.json --noEmit",
    "query:typecheck": "tsgo -p packages/query/tsconfig.json --noEmit",
    "prefabs:typecheck": "tsgo -p packages/prefabs/tsconfig.json --noEmit",
    "demo:typecheck": "tsgo -p apps/demo/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.5.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.0.0",
    "@floating-ui/dom": "^1.7.6",
    "@tanstack/router-generator": "^1.150.0",
    "@tiptap/core": "3.20.4",
    "@tiptap/extension-bubble-menu": "3.20.4",
