language js

// Destructuring a component's props unwraps them once and kills reactivity. The property
// access is what tracks, so the child must read `props.x` at the point of use.
//
// Only PascalCase functions are matched: plain helper functions destructure freely.
or {
  `function $name({ $props }) { $body }` where {
    $name <: r"[A-Z][A-Za-z0-9_]*",
    register_diagnostic(
      span = $props,
      message = "Destructured props lose reactivity. Take `props` whole and read `props.x` where it is used; use `omit(props, ...)` to forward the rest.",
      severity = "error"
    )
  },
  `const $name = ({ $props }) => $body` where {
    $name <: r"[A-Z][A-Za-z0-9_]*",
    register_diagnostic(
      span = $props,
      message = "Destructured props lose reactivity. Take `props` whole and read `props.x` where it is used; use `omit(props, ...)` to forward the rest.",
      severity = "error"
    )
  }
}
